# BIZTONSÁGI TITKOK (SECRETS) - ELSŐ BEÜZEMELÉSKOR KÖTELEZŐEN MÓDOSÍTANDÓ!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeAdminPassword123!
JWT_SECRET=change-this-to-a-secure-random-jwt-key-min-32-chars

# Platform által biztosított Adatbázis (PostgreSQL Managed Service)
DB_ENGINE=postgres
DB_HOST=paas-postgres.databases.svc.cluster.local
DB_PORT=5432
DB_NAME=mes_db
DB_USER=postgres
DB_PASSWORD=ChangeMeDatabasePassword123!
DB_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:postgresql://paas-postgres.databases.svc.cluster.local:5432/mes_db
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Portál adatbázis
PORTAL_DB_ENGINE=postgres
PORTAL_DB_HOST=portal-db
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=portal_db 
PORTAL_DB_USER=portal_admin
PORTAL_DB_PASSWORD=PortalSecurePass2026!

# Biztonsági mentés hozzáférés (MinIO / S3)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=ChangeMeMinioSecretKey123!

# GitOps & Repó hozzáférés
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere


# HÁLÓZAT ÉS PORTÁL BEÁLLÍTÁSOK (CONFIGMAPS)
PORTAL_PORT=8088
PORTAL_BACKEND_PORT=3002
FRONTEND_PORT=8088
BACKEND_PORT=3002
BACKEND_INTERNAL_PORT=3000
NODE_ENV=production
CORS_ORIGIN=*

# Portál Frontend Auth tárolási kulcsok
VITE_AUTH_TOKEN_KEY=paas_auth_token
VITE_AUTH_USER_KEY=paas_auth_user

# KUBERNETES CÉLKÖRNYEZET & NÉVTEREK
K8S_SERVER_HOST=host.docker.internal
PLATFORM_NAMESPACE=platform-infra
APP_NAMESPACE=app-mes

# MEGFIGYELHETŐSÉG (OBSERVABILITY)
PROMETHEUS_URL=http://host.docker.internal:9090
GRAFANA_URL=http://host.docker.internal:3001

# REZILIENCIA & KÁOSZ CÉLPONT (MES APP)
RESILIENCE_PROXY_URL=http://host.docker.internal:30880
TARGET_APP_HOST=mes-backend.app-mes.svc.cluster.local
DEFAULT_RATE_LIMIT_RPS=100
DEFAULT_BURST_MULTIPLIER=5

# GITOPS & TELEPÍTÉSI PIPELINE
GIT_REPO_URL=https://github.com/DrozsdikAdam/Szakdolgozat.git
PRODUCTION_BRANCH=main
STAGING_BRANCH=develop
DEFAULT_STRATEGY=canary
DEFAULT_ROLLOUT_STRATEGY=canary

TARGET_ENV=production
STAGING_ENV=staging
TARGET_URL=http://mes.localhost
STAGING_URL=http://staging.mes.localhost

BACKEND_IMAGE=mes-backend
FRONTEND_IMAGE=mes-frontend

# TÁRHELY SERVICE (ALKALMAZÁS S3 OBJECT STORAGE)
APP_STORAGE_ROOT_USER=appstorageadmin
APP_STORAGE_ROOT_PASSWORD=StoragePassword123!
APP_STORAGE_BUCKET=mes-app-storage

# MENTÉSI TÁROLÓ HELY (MINIO)
S3_ENDPOINT=http://minio.platform-infra.svc.cluster.local:9000
S3_BUCKET=paas-backups