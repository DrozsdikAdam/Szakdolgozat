# Célkörnyezet neve
TARGET_ENV=production
STAGING_ENV=staging

# Az alkalmazás éles és teszt URL-je (ha még nincs, maradhat localhost vagy üresen)
TARGET_URL=http://mes.localhost
STAGING_URL=http://staging.mes.localhost

# Konténer nevek
BACKEND_IMAGE=mes-backend
FRONTEND_IMAGE=mes-frontend

# Telepítési stratégia (canary vagy blue-green)
DEFAULT_STRATEGY=canary
