# Célkörnyezet neve
TARGET_ENV=production
STAGING_ENV=staging

# Az alkalmazás éles és teszt URL-je (ha még nincs, maradhat localhost vagy üresen)
TARGET_URL=http://mes.localhost
STAGING_URL=http://staging.mes.localhost

# Konténer nevek és alkalmazás azonosító
APP_NAME=mes-backend
BACKEND_IMAGE=mes-backend
FRONTEND_IMAGE=mes-frontend

# Telepítési stratégia (canary vagy blue-green)
DEFAULT_STRATEGY=blue-green

# Gitops beállítások
GIT_REPO_URL=https://github.com/DrozsdikAdam/Szakdolgozat.git
STAGING_BRANCH=develop
PRODUCTION_BRANCH=main
APP_NAMESPACE=app-mes
