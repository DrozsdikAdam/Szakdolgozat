<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-machines-and-telemetry" author="mes-admin">
        <validCheckSum>any</validCheckSum>
        <validCheckSum>9:3d2acc3c3ef6b26ee0abdaad86f1afc5</validCheckSum>
        <validCheckSum>9:87f0703cb0648af73d308b3b555074d1</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="machines" />
            </not>
        </preConditions>

        <createTable tableName="machines">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="manufacturer" type="VARCHAR(255)" />
            <column name="model" type="VARCHAR(255)" />
            <column name="serial_number" type="VARCHAR(255)" />
            <column name="warranty_number" type="VARCHAR(255)" />
            <column name="warranty_end_date" type="TIMESTAMP" />
            <column name="ideal_cycle_time_seconds" type="DOUBLE" />
            <column name="target_pcs_per_hour" type="INT" />
            <column name="location" type="VARCHAR(255)" />
            <column name="assigned_user_id" type="UUID">
                <constraints foreignKeyName="fk_machines_assigned_user" references="users(id)" />
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="deleted_at" type="TIMESTAMP" />
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="machine_maintenance">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="machine_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_maintenance_machine" references="machines(id)" />
            </column>
            <column name="technician_id" type="UUID">
                <constraints foreignKeyName="fk_maintenance_technician" references="users(id)" />
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="description" type="TEXT" />
            <column name="root_cause" type="TEXT" />
            <column name="action_taken" type="TEXT" />
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="downtime_minutes" type="INT" />
            <column name="cost" type="DECIMAL(19, 2)" />
            <column name="start_date" type="TIMESTAMP" />
            <column name="maintenance_end" type="TIMESTAMP" />
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="machine_telemetry">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="machine_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_telemetry_machine" references="machines(id)" />
            </column>
            <column name="recorded_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="machine_status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="produced_count" type="INT" />
            <column name="scrap_count" type="INT" />
            <column name="temperature" type="DOUBLE" />
            <column name="vibration" type="DOUBLE" />
            <column name="power_kw" type="DOUBLE" />
            <column name="pressure_bar" type="DOUBLE" />
            <column name="work_order_id" type="UUID" />
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex indexName="idx_telemetry_machine_timestamp" tableName="machine_telemetry">
            <column name="machine_id" />
            <column name="recorded_at" />
        </createIndex>

    </changeSet>

</databaseChangeLog>
