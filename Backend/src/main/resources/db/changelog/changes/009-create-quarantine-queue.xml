<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-quarantine-queue" author="mes-admin">
        <validCheckSum>any</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="quarantine_queue" />
            </not>
        </preConditions>

        <createTable tableName="quarantine_queue">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="operation_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="entity_name" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="entity_id" type="VARCHAR(64)" />
            <column name="http_method" type="VARCHAR(10)">
                <constraints nullable="false" />
            </column>
            <column name="endpoint_url" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="payload_json" type="CLOB" />
            <column name="server_state_json" type="CLOB" />
            <column name="error_message" type="VARCHAR(2000)" />
            <column name="status" type="VARCHAR(20)" defaultValue="CONFLICT">
                <constraints nullable="false" />
            </column>
            <column name="retry_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="resolution_strategy" type="VARCHAR(30)" />
            <column name="resolved_by" type="VARCHAR(100)" />
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" />
            <column name="resolved_at" type="TIMESTAMP" />
        </createTable>

        <createIndex indexName="idx_quarantine_status" tableName="quarantine_queue">
            <column name="status" />
        </createIndex>

        <createIndex indexName="idx_quarantine_entity" tableName="quarantine_queue">
            <column name="entity_name" />
            <column name="entity_id" />
        </createIndex>

        <createIndex indexName="idx_quarantine_created_at" tableName="quarantine_queue">
            <column name="created_at" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
