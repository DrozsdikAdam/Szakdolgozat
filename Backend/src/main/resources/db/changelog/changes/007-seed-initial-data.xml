<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Unified Roles seed for PostgreSQL / MSSQL / Oracle / ANSI -->
    <changeSet id="007-seed-initial-roles" author="mes-admin">
        <validCheckSum>any</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM roles WHERE name = 'SYSTEMADMIN'</sqlCheck>
        </preConditions>

        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000001" />
            <column name="name" value="SYSTEMADMIN" />
            <column name="active" valueBoolean="true" />
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000002" />
            <column name="name" value="CEO" />
            <column name="active" valueBoolean="true" />
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000003" />
            <column name="name" value="MANAGER" />
            <column name="active" valueBoolean="true" />
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000004" />
            <column name="name" value="TECHNICIAN" />
            <column name="active" valueBoolean="true" />
        </insert>
        <insert tableName="roles">
            <column name="id" value="00000000-0000-0000-0000-000000000005" />
            <column name="name" value="OPERATOR" />
            <column name="active" valueBoolean="true" />
        </insert>
    </changeSet>

    <!-- Legacy Oracle HEXTORAW roles seed skipped in favor of unified 36-char string UUIDs -->
    <changeSet id="007-seed-initial-roles-oracle" author="mes-admin" dbms="oracle">
        <validCheckSum>any</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT 0 FROM DUAL WHERE 1=0</sqlCheck>
        </preConditions>
        <comment>Skipped: Unified changeset 007-seed-initial-roles handles Oracle using standard CHAR(36) UUIDs</comment>
    </changeSet>

