        <validCheckSum>any</validCheckSum>
        <validCheckSum>9:6237f2dd0b86c85e829fcd76db610123</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM users WHERE name = 'admin'</sqlCheck>
        </preConditions>

        <insert tableName="users">
            <column name="id" value="a0000000-0000-0000-0000-000000000001" />
            <column name="name" value="admin" />
            <column name="password"
                value="$2a$10$ZrCX8jW76alnJxNPgDe.J.h4ve0YomAlmrcIpHweFdA1NfMQvxG5a" />
            <column name="email" value="admin@mes.hu" />
            <column name="phone_number" value="+36301234567" />
            <column name="active" valueBoolean="true" />
            <column name="version" valueNumeric="0" />
            <column name="created_at" valueDate="2026-01-01T00:00:00" />
